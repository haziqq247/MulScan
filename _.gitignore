# MulScan .gitignore

# Output / scan reports (may contain sensitive info)
output/

# Secrets and environment files
.env
*.env
secrets.*
*.key
*.pem

# Python virtual environments
venv/
.venv/
env/

# Python build artifacts and cache
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/

# IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Real malware samples must NEVER be committed
samples/*
!samples/.gitkeep

# Generated test archives (recreate with the scripts in tests/)
tests/*.zip
